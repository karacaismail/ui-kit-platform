---
import ReportLayout from '../layouts/ReportLayout.astro';
import '../styles/roadmap.css';
import { roadmap } from '../roadmap/data.ts';
import { RoadmapViewModel } from '../roadmap/view-model.ts';

const view = new RoadmapViewModel(roadmap);
const totals = view.totals;
const aiParts = view.partsWithTag('ai');
const legacyParts = view.partsWithTag('legacy');
const decisionParts = view.partsWithTag('decision');
const stepCount = view.tiers.reduce((count, tier) => count + tier.steps.length, 0);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<ReportLayout title="Yol haritası" description="UI Kit platformunun PoC'den kurumsal olgunluğa fazlı geliştirme planı." current="roadmap">
  <p class="eyebrow">Geliştirme planı</p>
  <h1>Yol haritası</h1>
  <p class="rm-lead">{roadmap.vision}</p>
  <dl class="rm-stats">
    <div><dt>Faz</dt><dd>{totals.phases}</dd></div>
    <div><dt>Parça</dt><dd>{totals.parts}</dd></div>
    <div><dt>Tamam</dt><dd>{totals.done}</dd></div>
    <div><dt>Sırada</dt><dd>{totals.next}</dd></div>
    <div><dt>Planlı</dt><dd>{totals.planned}</dd></div>
  </dl>

  <section class="rm-section" id="oncelik" aria-labelledby="oncelik-baslik">
    <p class="eyebrow">{view.tiers.length} kademe · {stepCount} adım</p>
    <h2 id="oncelik-baslik">Öncelik sırası</h2>
    <p>Fazlar neyin yapılacağını, bu sıra neyin önce yapılacağını söyler. Her kademe bir kapıyla kapanır; hiçbir kademede olmayan parçalar lansmandan sonra faz sırasıyla gelir.</p>
    <ol class="tiers">
      {view.tiers.map((tier, index) => (
        <li class="tier" id={`kademe-${tier.key}`}>
          <p class="eyebrow">{index + 1}. kademe</p>
          <h3>{tier.name}</h3>
          <p class="tier-gate"><b>Kapı:</b> {tier.gate}</p>
          <ol class="steps">
            {tier.steps.map(step => (
              <li class="step">
                <span class="step-number" aria-hidden="true">{step.number}</span>
                <div class="step-body">
                  <h4>{step.title}</h4>
                  <p>{step.why}</p>
                  <p class="step-owners">{step.owners.join(' · ')}</p>
                  <ul class="part-links" aria-label="Parçalar">
                    {step.parts.map(item => (
                      <li><a href={`#${item.anchor}`}><span class="mono">{item.code}</span><span>{item.title}</span></a></li>
                    ))}
                  </ul>
                  {step.sources.length > 0 && (
                    <ul class="finding-links" aria-label="Kaynak bulgular">
                      {step.sources.map(source => <li><a href={`${base}${source.href}`}>{source.id}</a></li>)}
                    </ul>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>
  </section>

  <section class="rm-section" id="gerekenler" aria-labelledby="gerekenler-baslik">
    <p class="eyebrow">Vizyon için</p>
    <h2 id="gerekenler-baslik">Vizyona ulaşmak için gerekenler</h2>
    <ul class="rm-columns">
      {roadmap.requirements.map(item => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.detail}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="rm-section" id="personalar" aria-labelledby="personalar-baslik">
    <p class="eyebrow">Hedef kitle</p>
    <h2 id="personalar-baslik">Personalar ve AI ile verilecek değer</h2>
    <ul class="rm-columns">
      {roadmap.personas.map(persona => (
        <li>
          <h3>{persona.name}</h3>
          <p>{persona.who}</p>
          <p>{persona.need}</p>
          <p class="rm-ai"><b>AI</b>{persona.ai}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="rm-section" id="ai" aria-labelledby="ai-baslik">
    <p class="eyebrow">{aiParts.length} parça</p>
    <h2 id="ai-baslik">Fazlara dağıtılan AI işleri</h2>
    <ul class="part-links">
      {aiParts.map(part => (
        <li><a href={`#${part.anchor}`}><span class="mono">{part.code}</span><span>{part.title}</span></a></li>
      ))}
    </ul>
  </section>

  <section class="rm-section" id="eski-plan" aria-labelledby="eski-plan-baslik">
    <p class="eyebrow">{legacyParts.length} parça</p>
    <h2 id="eski-plan-baslik">Eski plandan (ComponentSocial) alınanlar</h2>
    <ul class="part-links">
      {legacyParts.map(part => (
        <li><a href={`#${part.anchor}`}><span class="mono">{part.code}</span><span>{part.title}</span></a></li>
      ))}
    </ul>
  </section>

  <section class="rm-section" id="kararlar" aria-labelledby="kararlar-baslik">
    <p class="eyebrow">{decisionParts.length} parça</p>
    <h2 id="kararlar-baslik">Karar bekleyenler</h2>
    <p>Bu parçalar bir sahip kararı olmadan başlayamaz; ardından gelen işler onlara bağlıdır.</p>
    <ul class="part-links">
      {decisionParts.map(part => (
        <li><a href={`#${part.anchor}`}><span class="mono">{part.code}</span><span>{part.title}</span></a></li>
      ))}
    </ul>
  </section>

  <div class="rm-layout">
    <nav class="phase-index" aria-labelledby="fazlar-baslik">
      <p class="eyebrow" id="fazlar-baslik">Fazlar</p>
      <ol>
        {view.phases.map(phase => (
          <li>
            <a href={`#${phase.anchor}`}>
              <span class="mono">{phase.code}</span>
              <span class="rm-name">{phase.name}</span>
              <span class="rm-progress">{phase.progress.done}/{phase.progress.total}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <div class="phases">
      {view.phases.map(phase => (
        <section class="phase" id={phase.anchor} aria-labelledby={`${phase.anchor}-baslik`}>
          <p class="eyebrow">{phase.code} · {phase.stage}</p>
          <h2 id={`${phase.anchor}-baslik`}>{phase.name}</h2>
          <p>{phase.goal}</p>
          <dl class="phase-meta">
            <div><dt>Çıkış ölçütü</dt><dd>{phase.exit}</dd></div>
            <div><dt>Vibecoding notu</dt><dd>{phase.vibecoding}</dd></div>
          </dl>
          <ol class="parts">
            {phase.parts.map(part => (
              <li class="part" id={part.anchor}>
                <span class="part-code">{part.code}</span>
                <span class="part-status" data-status={part.status}>{part.statusLabel}</span>
                <div class="part-body">
                  <h3>{part.title}</h3>
                  <p>{part.detail}</p>
                  {(part.tags.length > 0 || part.tier) && (
                    <div class="part-tags">
                      {part.tier && <span class="badge tier-badge">{part.tier}</span>}
                      {part.tags.map(tag => <span class={`badge tag-${tag.key}`}>{tag.label}</span>)}
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>

</ReportLayout>
