---
import '../styles/global.css';
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// Storybook is not public: builds for an anonymous host (GitHub Pages) leave it out.
const storybookPublished = process.env.PUBLIC_STORYBOOK !== 'off';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#101214" />
    <meta name="description" content="Explore UI components, understand their behavior, and edit native web examples in a developer-focused workspace." />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <title>Component workspace — UI Kit</title>
    <script is:inline src={`${base}style-examples.js`} defer></script>
    <script is:inline src={`${base}app.js`} defer></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <button class="icon-button mobile-menu" data-action="navigation" aria-label="Open navigation">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
      <a class="brand" data-route href="?page=home" aria-label="UI Kit home">
        <span class="brandmark" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span>ui / kit</span>
      </a>
      <nav class="topnav" aria-label="Workspace">
        <a class="active" data-route href="?page=catalog">Components</a>
        <a data-route href="?page=guide">Documentation</a>
        {storybookPublished && <a href={`${base}storybook/index.html`}>Storybook</a>}
      </nav>
      <span class="top-spacer"></span>
      <button class="quicksearch" data-action="search" aria-label="Search components, Control or Command K">
        <span class="od-row"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 4 4"></path></svg>Quick search</span>
        <kbd>⌘ K</kbd>
      </button>
      <button class="icon-button search-icon" data-action="search" aria-label="Search components">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
      </button>
      <a class="icon-button button" data-route href="?page=guide" aria-label="Read the getting started guide">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m8 5-6 7 6 7m8-14 6 7-6 7M14 3l-4 18"></path></svg>
      </a>
    </header>
    <div class="layout">
      <nav class="sidebar" id="sidebar" aria-label="Component navigation"></nav>
      <main id="main" tabindex="-1">
        <section class="hero-copy">
          <p class="eyebrow">A workspace for your interface</p>
          <h1>Less setup.<br />More building.</h1>
          <p>Explore UI components, understand their behavior, and make the code your own.</p>
          <noscript><p>This interactive workspace needs JavaScript. Enable it to search components and edit the live examples.</p></noscript>
        </section>
      </main>
      <aside class="rightbar" id="rightbar" aria-label="On this page"></aside>
    </div>
    <dialog id="modal" aria-labelledby="modal-title"></dialog>
    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
  </body>
</html>
